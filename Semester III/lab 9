1. Min Heap and Max Heap

import heapq

a = [40, 20, 30, 10, 50]
heapq.heapify(a)
print("Min Heap:", a)
print("Min:", heapq.heappop(a))

b = [-x for x in [40, 20, 30, 10, 50]]
heapq.heapify(b)
print("Max:", -heapq.heappop(b))




2. Heap Sort

import heapq

def heap_sort(a):
    heapq.heapify(a)
    return [heapq.heappop(a) for _ in range(len(a))]

print(heap_sort([40, 10, 30, 50, 20]))




3. Searching and Sorting Comparison

import time

def linear(a, x):
    for i, v in enumerate(a):
        if v == x: return i
    return -1

def binary(a, x):
    l, r = 0, len(a)-1
    while l <= r:
        m = (l+r)//2
        if a[m] == x: return m
        if a[m] < x: l = m+1
        else: r = m-1
    return -1

def bubble(a):
    for i in range(len(a)):
        for j in range(len(a)-i-1):
            if a[j] > a[j+1]:
                a[j], a[j+1] = a[j+1], a[j]
    return a

def selection(a):
    for i in range(len(a)):
        m = min(range(i, len(a)), key=a.__getitem__)
        a[i], a[m] = a[m], a[i]
    return a

def insertion(a):
    for i in range(1, len(a)):
        x, j = a[i], i-1
        while j >= 0 and a[j] > x:
            a[j+1] = a[j]
            j -= 1
        a[j+1] = x
    return a

def quick(a):
    if len(a) <= 1: return a
    p = a[len(a)//2]
    return quick([x for x in a if x < p]) + \
           [x for x in a if x == p] + \
           quick([x for x in a if x > p])

def merge(a):
    if len(a) <= 1: return a
    m = len(a)//2
    l, r = merge(a[:m]), merge(a[m:])
    out = []
    while l and r:
        out.append((l if l[0] < r[0] else r).pop(0))
    return out + l + r

def bucket(a):
    if not a: return a
    lo, hi = min(a), max(a)
    if lo == hi: return a
    b = [[] for _ in a]
    for x in a:
        b[min(int((x-lo)/(hi-lo)*len(a)), len(a)-1)].append(x)
    return sum((insertion(v) for v in b), [])

data = [45, 12, 78, 23, 9, 56, 34]
for f in [bubble, selection, insertion, quick, merge, bucket]:
    start = time.perf_counter()
    print(f.__name__, f(data.copy()),
          round(time.perf_counter()-start, 6), "seconds")

