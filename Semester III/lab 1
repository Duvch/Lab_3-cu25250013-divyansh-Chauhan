Linear Search
import time

def linear_search(a, x):
    for i in range(len(a)):
        if a[i] == x:
            return i
    return -1

for n in [10000, 50000, 100000]:
    a = list(range(n))
    start = time.perf_counter()
    linear_search(a, n - 1)
    end = time.perf_counter()
    print(n, round((end-start)*1000000, 2), "microseconds")

import time

def binary_search(a, x):
    l, r = 0, len(a)-1

    while l <= r:
        m = (l+r)//2
        if a[m] == x:
            return m
        elif a[m] < x:
            l = m+1
        else:
            r = m-1

    return -1

for n in [10000, 50000, 100000]:
    a = list(range(n))
    start = time.perf_counter()
    binary_search(a, n-1)
    end = time.perf_counter()
    print(n, round((end-start)*1000000, 2), "microseconds")

