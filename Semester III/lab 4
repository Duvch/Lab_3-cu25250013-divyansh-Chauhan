class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

top = None

def push():
    global top
    n = Node(int(input("Enter value: ")))
    n.next = top
    top = n

def pop():
    global top
    if top is None:
        print("Stack Underflow")
    else:
        print("Popped:", top.data)
        top = top.next

def display():
    t = top
    while t:
        print(t.data, end=" ")
        t = t.next
    print()

while True:
    print("\n1.Push  2.Pop  3.Display  4.Exit")
    ch = int(input("Enter choice: "))

    if ch == 1:
        push()
    elif ch == 2:
        pop()
    elif ch == 3:
        display()
    elif ch == 4:
        break

