import heapq

def optimal_merge(files):
    heapq.heapify(files)
    total = 0

    while len(files) > 1:
        a = heapq.heappop(files)
        b = heapq.heappop(files)

        cost = a + b
        total += cost

        print("Merging:", a, b)
        heapq.heappush(files, cost)

    print("Minimum Cost:", total)

