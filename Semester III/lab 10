print("Adjacency List:", graph)

def dfs(start):
    seen = set()
    stack = [start]
    order = []

    while stack:
        u = stack.pop()

        if u not in seen:
            seen.add(u)
            order.append(u)
            stack.extend(reversed(graph[u]))

    return order

def bfs(start):
    seen = {start}
    q = deque([start])
    order = []

    while q:
        u = q.popleft()
        order.append(u)

        for v in graph[u]:
            if v not in seen:
                seen.add(v)
                q.append(v)

    return order

print("DFS:", dfs(0))
print("BFS:", bfs(0))
