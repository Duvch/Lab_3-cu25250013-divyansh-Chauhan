a = [10, 20, 30, 40, 50]

while True:
    print("\n1.Insert  2.Delete  3.Search  4.Display  5.Exit")
    ch = int(input("Enter choice: "))

    if ch == 1:
        i = int(input("Enter index: "))
        x = int(input("Enter value: "))
        if 0 <= i <= len(a):
            a.insert(i, x)
        else:
            print("Invalid index")

    elif ch == 2:
        i = int(input("Enter index: "))
        if 0 <= i < len(a):
            print("Deleted:", a.pop(i))
        else:
            print("Invalid index")

    elif ch == 3:
        x = int(input("Enter value: "))
        if x in a:
            print("Found at index:", a.index(x))
        else:
            print("Not found")

    elif ch == 4:
        print("Array:", a)

    elif ch == 5:
        break

    else:
        print("Invalid choice")

